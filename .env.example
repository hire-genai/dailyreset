# ── DATABASE ─────────────────────────────────────
# Required: PostgreSQL connection string (Vercel Postgres, Supabase, Neon, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT ──────────────────────────────────────────
# Change this to a long random string in production
JWT_SECRET=replace-with-a-long-random-secret-string

# ── EMAIL / SMTP ──────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="Daily Reset <no-reply@yourdomain.com>"

# ── DEV MODE ─────────────────────────────────────
# Set to "true" to print OTP to console instead of emailing (for local dev)
DEV_MODE=true
