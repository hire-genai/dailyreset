# ── JWT ──────────────────────────────────────────
# Change this to a long random string in production
JWT_SECRET=replace-with-a-long-random-secret-string

# ── EMAIL / SMTP ──────────────────────────────────
# For Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords
# Use that 16-char App Password as SMTP_PASS (not your real password)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=Daily Reset <your-email@gmail.com>

# ── SERVER ───────────────────────────────────────
PORT=3000

# ── DEV MODE ─────────────────────────────────────
# Set to "true" to print OTP to console instead of emailing (for local dev)
DEV_MODE=false
